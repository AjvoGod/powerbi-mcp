# Azure AD App Registration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Optional: default workspace ID (if not provided, tools will list all accessible workspaces)
# POWERBI_DEFAULT_WORKSPACE_ID=your-workspace-id

# Optional: PBIX root folder for local tools.
# Relative filePath/directoryPath values in PBIX tools are resolved against this folder.
# POWERBI_PBIX_ROOT=/cesta/k/tvým/pbix/souborům
