{
  "name": "powerbi-mcp",
  "version": "1.0.0",
  "description": "MCP server for Power BI — workspace management, dataset operations, report export, PBIX local analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "powerbi-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc",
    "prepare": "npm run build",
    "start:mcp": "node scripts/start-mcp.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "mcp",
    "powerbi",
    "power-bi",
    "model-context-protocol",
    "pbix",
    "ai",
    "llm",
    "claude",
    "copilot",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ivoschwarz/powerbi-mcp"
  },
  "author": "Ivo Schwarz",
  "dependencies": {
    "@azure/msal-node": "^2.16.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "adm-zip": "^0.5.16",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "license": "MIT"
}